# Copy to .env: cp .env.example .env (or copy on Windows)

# --- PostgreSQL (metadata + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=knowledge_assistant
# Host tools only; Compose overrides DATABASE_URL to use hostname `db`.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Vector store ---
# Must match embedding model output and db/schema vector(n)
VECTOR_DIMENSION=384

# --- Internal services (HTTP) ---
RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8000
RAG_SERVICE_URL=http://localhost:8000
# API container → RAG (full Compose stack)
RAG_SERVICE_URL_DOCKER=http://rag:8000
# API in Docker, RAG on host only: http://host.docker.internal:8000
# How long the Go API waits for one RAG call (embed on ingest, or query + LLM).
RAG_CLIENT_TIMEOUT_SECONDS=180

API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://localhost:8080

# --- Embeddings ---
# e.g. sentence-transformers/all-MiniLM-L6-v2 (384 dims) or set VECTOR_DIMENSION accordingly
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local

# --- Chunking (RAG ingest) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5

# --- LLM generation (Ollama) ---
LLM_PROVIDER=ollama
# Host / MCP: local daemon published by Compose (OLLAMA_PORT)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# RAG container → Ollama service on the Compose network
OLLAMA_BASE_URL_DOCKER=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=300
# Ollama Cloud instead: OLLAMA_BASE_URL=https://ollama.com,
# OLLAMA_BASE_URL_DOCKER=https://ollama.com, set OLLAMA_API_KEY, pick a *-cloud model
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- MCP (stdio; Claude Desktop spawns `python -m rag.mcp`) ---
# No listen port. Env for the MCP process is set in claude_desktop_config.json
# (see services/rag/README.md). Same Postgres / Ollama / embedding vars as RAG.

# --- App ---
LOG_LEVEL=info
ENVIRONMENT=development
# Browser origins allowed to call the API and RAG (React dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
